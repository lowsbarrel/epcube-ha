# Copy to .env and fill in. NEVER commit the real .env - only this example.
# Every variable the code reads appears here with a safe placeholder, so the list
# of required config has one home (AGENTS.md: "one home per concept").

# Which regional cluster the account lives on: EU, US or JP.
# An account exists on exactly one. A token minted against the wrong cluster is
# rejected as "User token expired", which looks identical to a genuinely expired
# one - so get this right before debugging a token.
EPCUBE_REGION="EU"

# A Bearer token for the API. The "Bearer " prefix is optional.
# Mint one with:  uv run epcube login --save
EPCUBE_TOKEN=""

# Account credentials, used only to mint a token. Needs the `login` extra
# installed (uv sync --extra login) because the sign-in endpoint is CAPTCHA-gated.
EPCUBE_EMAIL=""
EPCUBE_PASSWORD=""

# Optional: pin the plant serial to skip the account lookup on every run.
EPCUBE_SN=""

# Optional: pin the numeric device id to skip the live-data lookup.
EPCUBE_DEVICE_ID=""
